  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1"
  }
}
